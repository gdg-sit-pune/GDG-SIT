# Used by `npm run dev:emulators` to run against local Firebase emulators.
# No real Firebase project or credentials needed. Start the emulators first with `npm run emulators`.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-gdg-sit.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-gdg-sit
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
ADMIN_EMAILS=uttkarsh.ruparel.btech2023@sitpune.edu.in

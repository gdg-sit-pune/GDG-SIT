# Copy this file to .env.local and fill in the values from your Firebase project.
# See README.md ("Setting up Firebase") for where to find each one.

# Firebase web app config (Project settings > General > Your apps > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service account for the server (Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key on one line, keeping the \n sequences, inside double quotes
FIREBASE_PRIVATE_KEY=

# Vercel Blob store for event photos (added automatically on Vercel when the store is connected;
# copy it here for local uploads)
BLOB_READ_WRITE_TOKEN=

# Google accounts allowed into /admin, comma separated
ADMIN_EMAILS=uttkarsh.ruparel.btech2023@sitpune.edu.in

# The site's public address, used for link previews (optional on Vercel)
NEXT_PUBLIC_SITE_URL=
